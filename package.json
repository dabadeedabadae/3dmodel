{
  "name": "fitcast-photo-garments",
  "version": "0.1.0",
  "private": true,
  "description": "FitCast Photo Garments — photo -> pixel low-poly garment module (Three.js + TypeScript, standalone dev page)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:body": "node --import tsx scripts/check-body.ts 300",
    "check:fit": "node --import tsx scripts/check-fit.ts",
    "render:body": "node scripts/render-body.mjs",
    "check:tshirt": "vitest run tests/tshirt.geometry.test.ts && node --import tsx scripts/check-tshirt.ts",
    "render": "node scripts/render.mjs",
    "eval:fixtures": "node --import tsx scripts/eval-fixtures.ts",
    "e2e:pipeline": "node scripts/e2e-pipeline.mjs",
    "e2e:fit": "node scripts/e2e-fit.mjs",
    "e2e:chain": "node scripts/e2e-chain.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:tshirt && npm run check:body && npm run check:fit && npm run build",
    "ib:prepare": "node --import tsx imported-body/scripts/prepare.ts imported-body/assets/source.fbx 165",
    "ib:check": "node --import tsx imported-body/scripts/check.ts",
    "ib:render": "node imported-body/scripts/render.mjs",
    "ib:viewer": "vite --port 5176 --open /imported-body/viewer/index.html",
    "ib:rig": "node --import tsx imported-body/scripts/check-rig.ts",
    "ib:fit": "node --import tsx imported-body/scripts/check-fit.ts",
    "ib:dress": "node --import tsx imported-body/scripts/dress.ts",
    "ib:export": "node --import tsx imported-body/scripts/export.ts",
    "ib:verify": "npm run ib:check && npm run ib:rig && npm run ib:fit && npm run ib:dress && npm run ib:dress-sim",
    "ib:garment": "node --import tsx imported-body/scripts/prepare-garment.ts imported-body/assets/tshirt.fbx tshirt",
    "ib:sim": "node --import tsx imported-body/scripts/simulate.ts",
    "ib:live": "vite --port 5176 --open \"/imported-body/viewer/index.html?sim=tshirt-base&live=1&view=threequarter\"",
    "ib:dress-sim": "node --import tsx imported-body/scripts/dress-sim.ts",
    "ib:outfit": "node --import tsx imported-body/scripts/prepare-outfit.ts imported-body/assets/outfit-01.fbx outfit01 175",
    "ib:outfit-check": "IB_ASSET=imported-body/out/asset-outfit01.json node --import tsx imported-body/scripts/check-outfit.ts",
    "ib:outfit-render": "IB_A=outfit01 node imported-body/scripts/render.mjs ofit outfit",
    "ib:outfit-viewer": "vite --port 5176 --open \"/imported-body/viewer/index.html?asset=outfit01\"",
    "ib:outfits": "node imported-body/scripts/prepare-outfits.mjs",
    "ib:photo": "node --import tsx imported-body/scripts/photo-garment.ts",
    "catalog:sync": "node imported-body/scripts/catalog-sync.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.185.4",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
